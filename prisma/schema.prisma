// ─────────────────────────────────────────────────────────────
// Order Management System — Bookstore
// Prisma schema. Designed up-front for the whole system; features
// are built incrementally on top of this in later milestones.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection (used at runtime, e.g. Neon's "pooled" string)
  directUrl = env("DIRECT_URL")     // direct/unpooled connection (used for migrations only)
}

// ───────────── Enums ─────────────

enum CustomerStatus {
  PENDING   // self-signup, awaiting staff approval
  ACTIVE    // approved, can log in to the portal
  REJECTED  // signup declined by staff
  ARCHIVED  // soft-deleted — has order/payment history that must be kept
}

enum OrderType {
  READY_STOCK     // in stock, full payment upfront
  EVENT_JASTIP    // jastip / event pre-order, full payment upfront
  PO_REGULAR      // regular pre-order batch, DP allowed
  PO_REMAINDER    // remainder/leftover pre-order batch, DP allowed
}

enum Courier {
  LION
  OJEK
  SHOPEE
}

enum ExpenseCategory {
  PACKING
  SHIPPING_TO_WAREHOUSE
  OTHER
}

enum RequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum BookFormat {
  PAPERBACK
  HARDCOVER
  BOXSET
}

enum StaffRole {
  ADMIN
  STAFF
}

enum OrderStatus {
  WAITING          // open — placed, not yet shipped from supplier
  IN_TRANSIT       // dalam perjalanan ke Indonesia
  ARRIVED_COUNTRY  // tiba di Indonesia (customs/port)
  ARRIVED          // tiba di gudang kita — ready to pack
  SHIPPED          // terkirim ke customer
  COMPLETED        // delivered & closed
  CANCELLED
}

enum DpType {
  PERCENTAGE      // dpValue = percent of order total, e.g. 25 = 25%
  FIXED_PER_BOOK  // dpValue = rupiah per book (x total quantity)
  FIXED_TOTAL     // dpValue = flat rupiah amount for the whole order
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERPAID
}

enum DepositTxnType {
  TOP_UP        // customer pays in / overpays -> increases balance
  USED          // applied to an order -> decreases balance
  REFUND        // paid back to customer -> decreases balance
  ADJUSTMENT    // manual correction by admin
}

enum InvoiceType {
  DEPOSIT
  FINAL_PAYMENT
  READY_STOCK
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  EXPORT
  IMPORT
}

// ───────────── Core Models ─────────────

/// Admin / Staff accounts (username + password login)
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         StaffRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated   Order[]            @relation("OrderCreatedBy")
  paymentsRecorded Payment[]         @relation("PaymentRecordedBy")
  depositTxns     DepositTransaction[] @relation("DepositTxnCreatedBy")
  invoicesIssued  Invoice[]          @relation("InvoiceIssuedBy")
  expensesRecorded Expense[]         @relation("ExpenseCreatedBy")
  topUpsConfirmed TopUpRequest[]     @relation("TopUpConfirmedBy")
  addressChangesConfirmed AddressChangeRequest[] @relation("AddressChangeConfirmedBy")
  auditLogs       AuditLog[]

  @@map("users")
}

/// Customer accounts (phone-number-only login for the portal)
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String?
  notes     String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           Order[]
  payments         Payment[]
  depositTxns      DepositTransaction[]
  topUpRequests    TopUpRequest[]
  addressChangeRequests AddressChangeRequest[]

  @@index([name])
  @@index([status])
  @@map("customers")
}

/// Book catalog (used to prefill order items; historical order items keep
/// their own snapshot of title/price so catalog edits never rewrite history)
model Book {
  id           String   @id @default(cuid())
  title        String
  author       String?
  isbn         String?  @unique
  format       BookFormat?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  publisherId  String?
  publisher    Publisher? @relation(fields: [publisherId], references: [id])

  orderItems OrderItem[]

  @@index([title])
  @@index([publisherId])
  @@map("books")
}

/// A supplier we buy stock/PO batches from (e.g. a Singapore/Australia
/// distributor). Used to group orders into one invoice/shipment batch.
model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseBatches PurchaseBatch[]
  orders          Order[]

  @@index([name])
  @@map("suppliers")
}

/// A book publisher (e.g. Gramedia, Bhuana Ilmu Populer). Attached per book,
/// since one supplier batch can carry books from several publishers.
model Publisher {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books     Book[]

  @@index([name])
  @@map("publishers")
}

/// A named purchase-order batch (e.g. "Fast PO — July Batch 2"). Groups
/// orders together so invoicing rules and expected timing can be set once
/// per batch instead of per order.
/// A PO batch groups every order sharing the same order type + PO month +
/// supplier — this is the same key used to auto-merge orders (see
/// lib/order-merge.ts) and lib/po-batch.ts auto-finds-or-creates the right
/// batch as orders are entered, so this never has to be picked by hand for
/// PO_REGULAR / PO_REMAINDER orders.
model PurchaseBatch {
  id                  String      @id @default(cuid())
  name                String
  type                OrderType
  poMonth             String?
  etaMonth            String?
  batchDate           DateTime    @default(now())
  expectedArrivalDate DateTime?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  supplierId          String?
  supplier            Supplier?   @relation(fields: [supplierId], references: [id])

  orders              Order[]

  @@index([type])
  @@index([supplierId])
  @@index([type, poMonth, supplierId])
  @@map("purchase_batches")
}

/// Customer order (a batch of pre-ordered / imported books)
model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique // e.g. ORD-2026-000123
  customerId            String
  customer              Customer    @relation(fields: [customerId], references: [id])
  orderDate             DateTime    @default(now())
  expectedArrivalDate   DateTime?
  actualArrivalDate     DateTime?
  status                OrderStatus @default(WAITING)
  notes                 String?

  // Order type + the fields used to auto-merge repeat submissions into one
  // invoice-worthy order (same customer + PO month + order type + supplier
  // = same order — see lib/order-merge.ts). poMonth/etaMonth are "YYYY-MM"
  // strings, only meaningful for PO_REGULAR / PO_REMAINDER; eventName is a
  // free-text label for EVENT_JASTIP (e.g. "Big Bad Wolf 2026").
  orderType             OrderType   @default(READY_STOCK)
  poMonth               String?
  etaMonth              String?
  eventName             String?

  // DP rule for this order (only meaningful for PO_REGULAR / PO_REMAINDER).
  // Set once when the order is first created; carried through automatically
  // for any later items merged into it (see lib/order-merge.ts) and used to
  // auto-compute the amount of the DEPOSIT invoice.
  dpType                DpType?
  dpValue               Decimal?    @db.Decimal(12, 2)

  poBatchId             String?
  poBatch               PurchaseBatch? @relation(fields: [poBatchId], references: [id])

  supplierId            String?
  supplier              Supplier?   @relation(fields: [supplierId], references: [id])

  courier               Courier?
  trackingNumber        String?

  // Denormalized, recalculated fields for fast dashboard/reporting reads.
  // Always derived from OrderItem + Payment + DepositTransaction — never
  // edited directly by the UI. See lib/calculations.ts.
  subtotal              Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal         Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal     @default(0) @db.Decimal(12, 2)
  totalCogs             Decimal     @default(0) @db.Decimal(12, 2)
  profit                Decimal     @default(0) @db.Decimal(12, 2)
  amountPaid            Decimal     @default(0) @db.Decimal(12, 2)
  outstandingBalance    Decimal     @default(0) @db.Decimal(12, 2)
  paymentStatus         PaymentStatus @default(UNPAID)

  createdById           String?
  createdBy             User?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items                 OrderItem[]
  payments              Payment[]
  invoices              Invoice[]
  depositTxns           DepositTransaction[]
  expenses              Expense[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([poBatchId])
  @@index([supplierId])
  @@index([customerId, orderType, poMonth, supplierId])
  @@map("orders")
}

/// One book line inside an order
model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId       String?
  book         Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)

  // Snapshot fields (kept even if the Book catalog entry changes later)
  bookTitle    String
  isbn         String?
  format       BookFormat?
  quantity     Int
  sellingPrice Decimal  @db.Decimal(12, 2)
  cogs         Decimal  @db.Decimal(12, 2) @default(0)
  discount     Decimal  @db.Decimal(12, 2) @default(0)
  subtotal     Decimal  @db.Decimal(12, 2) // (sellingPrice * qty) - discount

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
  @@map("order_items")
}

/// A payment made by a customer, optionally tied to a specific order.
/// A payment with no orderId (or one exceeding the order's balance) is
/// what generates a DepositTransaction of type TOP_UP.
model Payment {
  id            String        @id @default(cuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  orderId       String?       // denormalized from invoice.orderId, for fast order-level lookups
  order         Order?        @relation(fields: [orderId], references: [id])
  invoiceId     String?       // the specific invoice this payment pays down — chosen manually
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  date          DateTime      @default(now())
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  notes         String?

  recordedById  String?
  recordedBy    User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([customerId])
  @@index([orderId])
  @@index([invoiceId])
  @@map("payments")
}

/// Full, transparent history of every change to a customer's deposit balance
model DepositTransaction {
  id            String         @id @default(cuid())
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  type          DepositTxnType
  amount        Decimal        @db.Decimal(12, 2) // always positive; sign implied by type
  balanceAfter  Decimal        @db.Decimal(12, 2)
  orderId       String?        // denormalized from invoice.orderId, for fast order-level lookups
  order         Order?         @relation(fields: [orderId], references: [id])
  invoiceId     String?        // for USED: the specific invoice this deposit was applied to
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  notes         String?

  createdById   String?
  createdBy     User?          @relation("DepositTxnCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())

  @@index([customerId])
  @@index([invoiceId])
  @@map("deposit_transactions")
}

/// Generated invoices — the actual billing unit. Each invoice tracks its own
/// amountPaid/outstandingBalance/paymentStatus, computed by replaying its
/// Payments + DepositTransactions (see lib/invoice-calculations.ts) — never
/// edited directly. An Order can have several invoices over time (e.g. a
/// DEPOSIT invoice, then a FINAL_PAYMENT invoice once stock arrives, plus a
/// separate invoice for any items merged in later — see lib/order-merge.ts).
model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  type           InvoiceType
  amount         Decimal       @db.Decimal(12, 2)
  pdfPath        String?       // relative path / object-storage key

  amountPaid          Decimal       @default(0) @db.Decimal(12, 2)
  outstandingBalance  Decimal       @db.Decimal(12, 2)
  paymentStatus       PaymentStatus @default(UNPAID)

  issuedAt       DateTime      @default(now())
  paidAt         DateTime?     // set automatically once outstandingBalance hits 0
  sentAt         DateTime?     // set automatically when sent via WhatsApp (or toggled manually)

  issuedById     String?
  issuedBy       User?         @relation("InvoiceIssuedBy", fields: [issuedById], references: [id])
  createdAt      DateTime      @default(now())

  payments       Payment[]
  depositTxns    DepositTransaction[]

  @@index([orderId])
  @@map("invoices")
}

/// Operational costs (packing materials, shipping to warehouse, etc.) that
/// affect overall profit but aren't tied to a specific book's COGS.
model Expense {
  id            String          @id @default(cuid())
  date          DateTime        @default(now())
  category      ExpenseCategory
  description   String?
  amount        Decimal         @db.Decimal(12, 2)

  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id])

  createdById   String?
  createdBy     User?           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([date])
  @@index([category])
  @@map("expenses")
}

/// A customer's self-reported "I've transferred, please confirm" deposit
/// top-up. Never becomes a real Payment/DepositTransaction until staff
/// confirms it — this is just the customer's side of the handshake.
model TopUpRequest {
  id            String        @id @default(cuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?         @relation("TopUpConfirmedBy", fields: [confirmedById], references: [id])

  @@index([status])
  @@map("topup_requests")
}

/// A customer's self-requested address change. Doesn't touch Customer.address
/// until staff confirms it.
model AddressChangeRequest {
  id            String        @id @default(cuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  newAddress    String
  status        RequestStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  confirmedAt   DateTime?
  confirmedById String?
  confirmedBy   User?         @relation("AddressChangeConfirmedBy", fields: [confirmedById], references: [id])

  @@index([status])
  @@map("address_change_requests")
}

/// Audit trail for every meaningful mutation in the system
model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String      // e.g. "Order", "Customer", "Payment"
  entityId   String?
  summary    String?     // human-readable one-liner
  changes    Json?       // { before: {...}, after: {...} }
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
